# Copy to .env and fill in, or run: .\.venv\Scripts\python.exe scripts\set_key.py DEEPSEEK_API_KEY
# Never commit .env.
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# Freelancer.com personal access token (https://accounts.freelancer.com/settings/develop),
# valid 30 days. Save with: .\.venv\Scripts\python.exe scripts\set_key.py FREELANCER_OAUTH_TOKEN
FREELANCER_OAUTH_TOKEN=

# Telegram approval bot (token from @BotFather). TELEGRAM_OWNER_ID is filled in
# automatically when you pair with /start <code>.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# Mercor agent: a SEPARATE Telegram bot (own token from @BotFather). Owner ID is filled in on pairing.
MERCOR_TELEGRAM_BOT_TOKEN=
MERCOR_TELEGRAM_OWNER_ID=
